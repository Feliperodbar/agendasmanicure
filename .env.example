# Copie este arquivo para ".env" e preencha com os valores do seu projeto
# Supabase → Settings → API

# Endereço do projeto Supabase
SUPABASE_URL=

# Chave pública (anon) — pode ser usada no app
SUPABASE_ANON_KEY=

# Chave SECRETA (service_role) — somente no servidor.
# NUNCA coloque esta chave em código que roda no navegador ou no celular.
SUPABASE_SERVICE_ROLE_KEY=
